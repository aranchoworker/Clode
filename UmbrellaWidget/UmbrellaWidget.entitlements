<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Must match AppConstants.appGroupIdentifier and the app target's
	     entitlements file exactly, or the widget will silently read an empty
	     UserDefaults suite. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.example.umbrella</string>
	</array>
</dict>
</plist>
