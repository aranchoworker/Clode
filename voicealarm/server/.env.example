# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 절대 커밋하지 않는다.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# 로컬 개발용 Postgres (scripts/dev-db.sh start 로 띄운 클러스터 기준)
DATABASE_URL=postgresql://postgres@127.0.0.1:5433/voicealarm?schema=public

# 32자 이상. 운영에서는 반드시 새로 생성해서 쓴다.
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ISSUER=voicealarm

# access 15분 / refresh 30일 (스펙 기본값)
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000

# 로그인 브루트포스 방어: 5회 실패부터 30초 → 60 → 120 … (상한 1시간)
LOGIN_FAIL_THRESHOLD=5
LOGIN_LOCK_BASE_SEC=30
LOGIN_LOCK_MAX_SEC=3600

# 쉼표로 구분. * 는 전체 허용(개발용)
CORS_ORIGIN=*

# 서명 URL 에 쓰이는 외부 접근 주소. 실기기 테스트 시 PC 의 LAN IP 로 바꾼다.
PUBLIC_BASE_URL=http://localhost:3000

# 파일 저장소. 개발은 로컬 디스크, 운영은 S3 어댑터로 교체 예정
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage

# 녹음 제한. 30초는 iOS 알림음 상한에서 온 값이라 늘릴 수 없다
MAX_RECORDING_MS=30000
RECORDING_DURATION_TOLERANCE_MS=500
MAX_UPLOAD_BYTES=5242880

# 서명 URL 만료 (초)
UPLOAD_URL_TTL_SEC=600
DOWNLOAD_URL_TTL_SEC=600

# 트랜스코딩. ffmpeg 가 PATH 에 없으면 절대 경로를 넣는다
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# 푸시 발송. noop 은 로그만 남기고 실제로 안 보낸다(개발 기본값).
# fcm 으로 바꾸면 FIREBASE_SERVICE_ACCOUNT_PATH 의 키로 실제 발송한다.
PUSH_DRIVER=noop
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# 알람은 예약 시점으로부터 최소 이만큼 뒤여야 한다(초). 너무 임박하면 기기가
# 데이터 푸시를 받고 음성 파일을 내려받을 시간이 없다.
MIN_ALARM_LEAD_SEC=60
